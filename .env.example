DATABASE_URL=postgresql://postgres:postgres@localhost:5432/perler
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CARD_HASH_SECRET=
# 指向部署版本的完整修改源码仓库或下载地址，不能只指向上游仓库
NEXT_PUBLIC_SOURCE_URL=https://github.com/luoyuex/beadgrid
# Linux 部署请配置包含中文的字体，例如 Noto Sans CJK
EXPORT_FONT_PATH=
# 独立测试数据库（可选，不要指向生产数据库）
# PERLER_INTEGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/perler_test
